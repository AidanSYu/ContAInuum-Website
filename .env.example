# ─────────────────────────────────────────────────────────────────────────────
# contAInuum — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Dashboard → Project Settings → API). `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────────

# --- Frontend (exposed to the browser; MUST be prefixed VITE_) --------------
# The "Project URL" and the PUBLIC "anon"/"publishable" key. These are safe to
# ship to the browser — Row Level Security is what protects your data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Cloudflare Turnstile site key (public). Leave blank to disable the captcha
# locally — the contact/newsletter forms will still work in dev.
VITE_TURNSTILE_SITE_KEY=

# Feature flag: show the DEMO campaign metrics (handoff alert + stat cards) on
# the dashboard Overview. Leave OFF for customers — those numbers are illustrative
# (no ATLAS campaign backend yet). Set to "true" only for sales demos/screenshots.
VITE_SHOW_DEMO_METRICS=

# Feature flag: show the self-serve subscription plan picker + Stripe checkout in
# the app. Leave OFF for the design-partner phase — access is provisioned through
# pilot engagements (/app/escrow), not self-serve. Set to "true" to re-open self-serve.
VITE_SELF_SERVE_BILLING=

# ─────────────────────────────────────────────────────────────────────────────
# Server-only secrets — DO NOT prefix with VITE_ and NEVER import in frontend
# code. Set these as Supabase Edge Function secrets, not in this file:
#   supabase secrets set TURNSTILE_SECRET_KEY=... RESEND_API_KEY=... etc.
# Listed here only for reference.
# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY   (auto-injected into Edge Functions by Supabase)
# SUPABASE_URL                (auto-injected into Edge Functions by Supabase)
# TURNSTILE_SECRET_KEY=your-turnstile-secret
# RESEND_API_KEY=your-resend-key            # optional: email notifications
# CONTACT_NOTIFY_EMAIL=hello@containuum.io  # where contact emails are sent
# EMAIL_FROM=notifications@containuum.io     # verified sender for Resend
# SITE_URL=https://containuum.io             # confirm links + Stripe redirects
#
# --- Stripe (billing) — Edge Function secrets only, NEVER prefix with VITE_ ---
# STRIPE_SECRET_KEY=sk_test_...              # Stripe secret key
# STRIPE_WEBHOOK_SECRET=whsec_...            # from `stripe listen` / Dashboard webhook
#   Set with:  supabase secrets set STRIPE_SECRET_KEY=... STRIPE_WEBHOOK_SECRET=... SITE_URL=...
